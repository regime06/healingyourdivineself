@page "/"
@page "/home"
@rendermode InteractiveServer
<PageTitle>Healing Your Divine Self</PageTitle>

<section class="hero section">
    <div class="hero-copy">
        <p class="eyebrow">Chakra and Forensic Healing</p>
        <h1>Open the Gate to Your Life’s Purpose with Chakra and Forensic Healing—</h1>
        <h2>Unlock Your True Potential and<br />Step into a Life of Meaning and Fulfillment</h2>
        <a class="btn" href="https://workshops.healingyourdivineself.com">Join the Free Workshop</a>
    </div>
    <div class="hero-card">
        <img src="@PortraitUrl" alt="Nancylita Allan" />
        <h2>Nancylita Allan</h2>
        <p>Founder of Healing Your Divine Self</p>
        <span>Certified Forensic Healing Practitioner | Energy Healing Therapist | Akashic Record Reader | Magnetic Mind Coach</span>
    </div>
</section>

<section class="section about-grid">
    <div>
        <h2>Healing Your Divine Self: A Journey of Self-Discovery, Love, and Acceptance</h2>
        <h3>Have you ever felt trapped by the weight of past wounds, limiting beliefs, or an overwhelming sense of disconnection?</h3>
        <p>Healing Your Divine Self is the key to breaking free. It’s a transformative journey where you reconnect with your inner essence, release emotional pain, and embrace your authentic self.</p>
        <p>By cultivating self-love, inner peace, and spiritual growth, you’ll align with your true purpose and unlock the limitless potential that’s always been within you.</p>
    </div>
    <blockquote>“Healing is not about fixing what is broken; it’s about reconnecting with the divine essence within you.”</blockquote>
</section>

<section class="section services">
    @foreach (var service in Services)
    {
        <article class="service-card">
            <img src="@service.Image" alt="@service.Title" />
            <h3>@service.Title</h3>
            <p>@service.Text</p>
        </article>
    }
    <a class="btn outline" href="/transformative-services">Learn More</a>
</section>

<section class="section journey">
    <div>
        <h2>Are You Ready to Open the Gate to Your Life’s Purpose and Heal Your Divine Self?</h2>
        <p>Step into a transformative journey where you'll reconnect with your inner power and create a life aligned with your highest potential.</p>
        <h3>By Choosing This Journey, You Will:</h3>
        <ul>
            <li>Reconnect with your true essence and divine worthiness.</li>
            <li>Heal emotional wounds and release limiting beliefs.</li>
            <li>Discover your purpose and align with your passions.</li>
            <li>Cultivate self-love, inner peace, and spiritual growth.</li>
            <li>Manifest a life filled with love, abundance, and joy.</li>
        </ul>
    </div>
    <img src="@HandsUrl" alt="Healing support" />
</section>

<section class="workshop section narrow">
    <h2>Ready to heal and unlock your true potential?</h2>
    <p>Join our FREE workshop and begin your transformation today!</p>
    <a class="btn" href="https://workshops.healingyourdivineself.com">Join the Free Workshop</a>
</section>

<section class="section book">
    <div>
        <p class="quote">“Our chakra energy centres are our spiritual connection. Being aware of our energy and mood can help us recognise which energy centre needs clearing and activating.”</p>
        <h2>Healing Your Divine Self:<br />Opening the Gate to Your Life's Purpose</h2>
        <a class="btn" href="https://www.amazon.com/">Grab a Copy</a>
    </div>
    <img src="@BookUrl" alt="Healing Your Divine Self book" />
</section>

<section class="section testimonials">
    <h2>Transformational Journeys</h2>
    <div class="testimonial-grid">
        @foreach (var testimonial in Testimonials)
        {
            <article>
                <p>“@testimonial.Text”</p>
                <strong>@testimonial.Name</strong>
            </article>
        }
    </div>
    <a class="btn outline" href="/testimonials">See How Others Transformed</a>
</section>

<section class="final-cta section narrow">
    <h2>Yes, I'm Ready to Heal and Unlock My True Potential!</h2>
    <p>I’m ready to align my mind, body, and spirit, release what no longer serves me, and step into my true power to heal myself and others with love.</p>
    <a class="btn" href="/healing-programs">Check My Healing Programs</a>
</section>

